ALLOWED_ORIGINS=https://seuusuario.github.io,https://seu-site.onrender.com
PORT=8787

# PicPay (opcional — só se usar modo PicPay no app)
PICPAY_CLIENT_ID=
PICPAY_CLIENT_SECRET=
PICPAY_API_BASE=https://checkout-api.picpay.com
PICPAY_PIX_EXPIRATION_SEC=900

# Asaas (opcional — só se usar modo Asaas no app)
ASAAS_API_KEY=
# ASAAS_API_BASE=https://api-sandbox.asaas.com
# ASAAS_USER_AGENT=CartelaSorteio/1.0

# InfinitePay (opcional — só se usar modo InfinitePay no app)
# Sua InfiniteTag sem o $ (ex.: se no app é $minharifa, use minharifa)
INFINITEPAY_HANDLE=
# URL pública do servidor (para webhook); se vazio, deduz do request
# PUBLIC_SERVER_URL=https://seu-gateway.onrender.com
